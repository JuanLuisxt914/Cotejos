<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cotejador.app</groupId>
        <artifactId>cotejador</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>desktop-javafx</artifactId>
    <packaging>jar</packaging>

    <name>Cotejador Desktop JavaFX</name>

    <dependencies>
        <dependency>
            <groupId>com.cotejador.app</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cotejador.app</groupId>
            <artifactId>data-sqlite</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.zenjava</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>8.8.3</version>
                <configuration>
                    <mainClass>com.cotejador.app.desktop.MainApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
