<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cotejador.app.desktop.RegistroController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="events-view">

    <content>
        <VBox spacing="18"
              styleClass="view-container">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox spacing="24" VBox.vgrow="ALWAYS">
                <VBox spacing="14" styleClass="events-form-panel" HBox.hgrow="ALWAYS">
                    <Label text="Partidos" styleClass="view-title"/>

                    <Label text="Nombre del partido" labelFor="$partidoNombreField"/>
                    <TextField fx:id="partidoNombreField"
                               promptText="Nombre del partido"
                               accessibleText="Nombre del partido"
                               onAction="#agregarPartido"/>

                    <HBox spacing="6">
                        <Button text="Agregar partido" onAction="#agregarPartido" fx:id="agregarPartidoButton" styleClass="primary-action"
                                accessibleText="Agregar partido"/>
                        <Button text="Editar partido" onAction="#editarPartido" fx:id="editarPartidoButton"
                                accessibleText="Editar partido seleccionado"/>
                        <Button text="Eliminar partido" onAction="#eliminarPartido" fx:id="eliminarPartidoButton" styleClass="danger-action"
                                accessibleText="Eliminar partido seleccionado"/>
                    </HBox>

                    <Label text="Partidos del evento" styleClass="section-title"/>
                    <ListView fx:id="partidoList"
                              prefHeight="320.0"
                              minHeight="260.0"
                              VBox.vgrow="ALWAYS"
                              accessibleText="Lista de partidos"/>
                </VBox>

                <VBox spacing="14" styleClass="events-list-panel" HBox.hgrow="ALWAYS">
                    <Label text="Gallos" styleClass="view-title"/>

                    <Label text="Peso en gramos" labelFor="$galloPesoField"/>
                    <TextField fx:id="galloPesoField"
                               promptText="Peso en gramos"
                               accessibleText="Peso del gallo en gramos"
                               onAction="#focusGalloAnillo"/>

                    <Label text="Anillo" labelFor="$galloAnilloField"/>
                    <TextField fx:id="galloAnilloField"
                               promptText="Anillo"
                               accessibleText="Anillo del gallo"
                               onAction="#agregarGallo"/>

                    <CheckBox fx:id="galloObligatorioCheckBox"
                              text="Gallo obligatorio"
                              accessibleText="Marca el gallo como obligatorio"/>

                    <HBox spacing="6">
                        <Button text="Agregar gallo" onAction="#agregarGallo" fx:id="agregarGalloButton" styleClass="primary-action"
                                accessibleText="Agregar gallo"/>
                        <Button text="Editar gallo" onAction="#editarGallo" fx:id="editarGalloButton"
                                accessibleText="Editar gallo seleccionado"/>
                        <Button text="Eliminar gallo" onAction="#eliminarGallo" fx:id="eliminarGalloButton" styleClass="danger-action"
                                accessibleText="Eliminar gallo seleccionado"/>
                    </HBox>

                    <Label text="Gallos del partido" styleClass="section-title"/>
                    <ListView fx:id="galloList"
                              prefHeight="320.0"
                              minHeight="260.0"
                              VBox.vgrow="ALWAYS"
                              accessibleText="Lista de gallos"/>
                </VBox>
            </HBox>

        </VBox>
    </content>
</ScrollPane>
