<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cotejador.app.desktop.RegistroController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="events-view">

    <content>
        <VBox spacing="18"
              styleClass="view-container">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox fx:id="registroSplitBox" spacing="24" VBox.vgrow="ALWAYS">
                <VBox fx:id="partidosPanel" spacing="14" styleClass="events-form-panel" HBox.hgrow="ALWAYS">
                    <Label text="Partidos" styleClass="view-title"/>

                    <Label text="Nombre del partido" labelFor="$partidoNombreField"/>
                    <TextField fx:id="partidoNombreField"
                               promptText="Nombre del partido"
                               accessibleText="Nombre del partido"
                               onAction="#agregarPartido"/>

                    <HBox spacing="6">
                        <Button text="Agregar partido" onAction="#agregarPartido" fx:id="agregarPartidoButton" styleClass="primary-action"
                                accessibleText="Agregar partido"/>
                        <Button text="Editar partido" onAction="#editarPartido" fx:id="editarPartidoButton"
                                accessibleText="Editar partido seleccionado"/>
                    </HBox>

                    <Label text="Partidos del evento" styleClass="section-title"/>
                    <TableView fx:id="partidoTable"
                               prefHeight="320.0"
                               minHeight="260.0"
                               styleClass="fight-table"
                               VBox.vgrow="ALWAYS"
                               accessibleText="Tabla de partidos del evento">
                        <columns>
                            <TableColumn fx:id="partidoNombreColumn" text="Partido" minWidth="150.0"/>
                            <TableColumn fx:id="partidoOrdenColumn" text="Orden" minWidth="120.0"/>
                            <TableColumn fx:id="partidoAccionesColumn" text="Acciones" minWidth="130.0"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox fx:id="gallosPanel" spacing="14" styleClass="events-list-panel" HBox.hgrow="ALWAYS">
                    <Label fx:id="partidoSeleccionadoLabel"
                           text="Partido no seleccionado"
                           styleClass="section-title"
                           style="-fx-font-size: 18px; -fx-font-weight: 700;"/>
                    <Label text="Gallos" styleClass="view-title"/>

                    <Label text="Peso en gramos" labelFor="$galloPesoField"/>
                    <TextField fx:id="galloPesoField"
                               promptText="Peso en gramos"
                               accessibleText="Peso del gallo en gramos"
                               onAction="#focusGalloAnillo"/>

                    <Label text="Anillo" labelFor="$galloAnilloField"/>
                    <TextField fx:id="galloAnilloField"
                               promptText="Anillo"
                               accessibleText="Anillo del gallo"
                               onAction="#agregarGallo"/>

                    <HBox spacing="6">
                        <Button text="Agregar gallo" onAction="#agregarGallo" fx:id="agregarGalloButton" styleClass="primary-action"
                                accessibleText="Agregar gallo"/>
                        <Button text="Editar gallo" onAction="#editarGallo" fx:id="editarGalloButton"
                                accessibleText="Editar gallo seleccionado"/>
                    </HBox>

                    <Label text="Gallos del partido" styleClass="section-title"/>
                    <TableView fx:id="galloTable"
                               prefHeight="320.0"
                               minHeight="260.0"
                               styleClass="fight-table"
                               VBox.vgrow="ALWAYS"
                               accessibleText="Tabla de gallos del partido">
                        <columns>
                            <TableColumn fx:id="galloPesoColumn" text="Peso" prefWidth="120.0" minWidth="90.0"/>
                            <TableColumn fx:id="galloAnilloColumn" text="Anillo" prefWidth="120.0" minWidth="90.0"/>
                            <TableColumn fx:id="galloEntradaColumn" text="Entrada" prefWidth="120.0" minWidth="90.0"/>
                            <TableColumn fx:id="galloOrdenColumn" text="Ronda" prefWidth="170.0" minWidth="160.0"/>
                            <TableColumn fx:id="galloObligatorioColumn" text="Obligatorio" minWidth="110.0"/>
                            <TableColumn fx:id="galloAccionesColumn" text="Acciones" minWidth="210.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

        </VBox>
    </content>
</ScrollPane>
