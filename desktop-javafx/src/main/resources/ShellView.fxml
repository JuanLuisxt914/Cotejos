<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="shellRoot" prefHeight="980.0" prefWidth="1120.0" styleClass="app-shell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotejador.app.desktop.ShellController">

    <top>
        <VBox styleClass="header" xmlns="http://javafx.com/javafx">
            <padding>
                <Insets bottom="12" left="16" right="16" top="12" />
            </padding>

            <HBox spacing="12">
                <Button fx:id="menuButton" onAction="#toggleDrawer" styleClass="drawer-toggle-button" text="☰" />
                <Label styleClass="app-title" text="Cotejador" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="themeToggleButton" onAction="#toggleTheme" styleClass="theme-toggle-button" text="Tema claro" />
            </HBox>

            <HBox fx:id="eventInfoBar" managed="false" spacing="18" visible="false">
                <Label styleClass="event-info-label" text="Evento:" />
                <Label fx:id="eventNameLabel" styleClass="event-info-value" text="-" />
                <Label styleClass="event-info-label" text="Fecha:" />
                <Label fx:id="eventDateLabel" styleClass="event-info-value" text="-" />
                <Label styleClass="event-info-label" text="Gallos por partido:" />
                <Label fx:id="eventGallosLabel" styleClass="event-info-value" text="-" />
                <Label styleClass="event-info-label" text="Modo:" />
                <Label fx:id="eventModeLabel" styleClass="event-info-value" text="-" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox fx:id="drawerPanel" managed="false" maxWidth="250.0" prefWidth="250.0" spacing="8" styleClass="drawer-panel" visible="false">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <Label styleClass="section-title" text="Navegacion" />
            <Button fx:id="drawerEventosButton" onAction="#volverAEventos" styleClass="secondary-action" text="Cambiar evento" />
            <Button fx:id="drawerRegistroButton" onAction="#mostrarRegistro" styleClass="secondary-action" text="Registro" />
            <Button fx:id="drawerPeleasButton" onAction="#mostrarPeleas" styleClass="secondary-action" text="Peleas" />
            <Button fx:id="drawerCloseButton" onAction="#toggleDrawer" styleClass="secondary-action" text="Cerrar" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentStack" styleClass="app-content">
            <AnchorPane fx:id="eventosHost" />
            <AnchorPane fx:id="registroHost" managed="false" visible="false" />
            <AnchorPane fx:id="peleasHost" managed="false" visible="false" />

            <Region fx:id="drawerBackdrop" managed="false" onMouseClicked="#toggleDrawer" styleClass="drawer-backdrop" visible="false" StackPane.alignment="CENTER" />
        </StackPane>
    </center>

    <bottom>
        <HBox>
            <padding>
                <Insets bottom="12" left="12" right="12" top="12" />
            </padding>
            <Label fx:id="statusLabel"
                   maxWidth="Infinity"
                   styleClass="status-label"
                   text=""
                   wrapText="true"
                   HBox.hgrow="ALWAYS" />
        </HBox>
    </bottom>

</BorderPane>
